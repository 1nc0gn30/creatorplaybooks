#!/usr/bin/env python3
"""
CreatorPlaybooks v1.1.0 — Unicode U+2800 2x4 Sub-Pixel Braille Terminal TUI

Reads canonical shared/creators.json (35 creators, 115 plays, 20 places) and
optionally probes http://127.0.0.1:5185/health without leaking host home paths.
"""

from __future__ import annotations

import argparse
import curses
import json
import math
import os
import sys
import urllib.request
from pathlib import Path

VERSION = "1.1.0"
DEFAULT_PORT = int(os.environ.get("CREATORPLAYBOOKS_PORT", "5185"))
DEFAULT_HOST = os.environ.get("CREATORPLAYBOOKS_HOST", "127.0.0.1")

# Unicode Braille U+2800 bit offsets for a 2x4 sub-pixel cell:
# (0,0)=0x01, (0,1)=0x02, (0,2)=0x04, (0,3)=0x40
# (1,0)=0x08, (1,1)=0x10, (1,2)=0x20, (1,3)=0x80
BRAILLE_BITS = (
    (0x01, 0x08),
    (0x02, 0x10),
    (0x04, 0x20),
    (0x40, 0x80),
)


def resolve_repo_root() -> Path:
    script_dir = Path(__file__).resolve().parent
    candidates = [
        script_dir.parent,
        Path("/opt/creatorplaybooks"),
        Path.home() / "NullAITech" / "creatorplaybooks",
    ]
    for cand in candidates:
        if (cand / "shared" / "creators.json").is_file():
            return cand
    raise FileNotFoundError("Could not locate shared/creators.json")


def redact_path(p: Path) -> str:
    home = str(Path.home())
    raw = str(p)
    if raw.startswith(home):
        return "~" + raw[len(home):]
    return raw


def load_dataset(root: Path) -> dict:
    with (root / "shared" / "creators.json").open("r", encoding="utf-8") as fh:
        return json.load(fh)


def probe_daemon(host: str = DEFAULT_HOST, port: int = DEFAULT_PORT) -> dict:
    url = f"http://{host}:{port}/health"
    try:
        req = urllib.request.Request(url, headers={"Host": f"{host}:{port}"})
        with urllib.request.urlopen(req, timeout=0.6) as resp:
            if resp.status == 200:
                data = json.loads(resp.read().decode("utf-8"))
                return {"online": True, "url": f"http://{host}:{port}", "version": data.get("version", VERSION)}
    except Exception:
        pass
    return {"online": False, "url": f"http://{host}:{port}", "version": VERSION}


def render_braille_wave(cols: int = 44, rows: int = 3, phase: float = 0.0) -> list[str]:
    """Render a deterministic U+2800 2x4 sub-pixel Braille wave header."""
    px_w = cols * 2
    px_h = rows * 4
    grid = [[False] * px_w for _ in range(px_h)]
    for x in range(px_w):
        t = (x / max(1, px_w - 1)) * math.tau * 2.0 + phase
        y1 = int(round((math.sin(t) * 0.42 + 0.5) * (px_h - 1)))
        y2 = int(round((math.cos(t * 0.7 + 0.9) * 0.35 + 0.5) * (px_h - 1)))
        for y in (y1, y2):
            if 0 <= y < px_h:
                grid[y][x] = True
                if y + 1 < px_h:
                    grid[y + 1][x] = True

    lines: list[str] = []
    for r in range(rows):
        row_chars = []
        for c in range(cols):
            bits = 0
            for dy in range(4):
                for dx in range(2):
                    if grid[r * 4 + dy][c * 2 + dx]:
                        bits |= BRAILLE_BITS[dy][dx]
            row_chars.append(chr(0x2800 + bits))
        lines.append("".join(row_chars))
    return lines


def filter_creators(creators: list[dict], query: str = "", category: str = "") -> list[dict]:
    out = creators
    if category:
        cat_l = category.strip().lower()
        out = [c for c in out if (c.get("category") or "").lower() == cat_l]
    if query:
        q = query.strip().lower()
        out = [
            c for c in out
            if q in (c.get("name") or "").lower()
            or q in (c.get("handle") or "").lower()
            or q in (c.get("bio") or "").lower()
            or any(q in t.lower() for t in c.get("tags") or [])
            or any(q in (p.get("title") or "").lower() for p in c.get("plays") or [])
        ]
    return out


def render_once(dataset: dict, daemon: dict, query: str, category: str) -> str:
    creators = filter_creators(dataset.get("creators", []), query=query, category=category)
    stats = dataset.get("stats", {})
    wave = render_braille_wave(cols=56, rows=3, phase=0.35)
    status_str = f"ONLINE ({daemon['url']})" if daemon["online"] else "IDLE (run: creatorplaybooks serve)"

    lines = [
        "┌────────────────────────────────────────────────────────────────────────────┐",
        f"│ CREATORPLAYBOOKS v{VERSION} · UNICODE U+2800 BRAILLE PLAYBOOK TUI             │",
        f"│ Daemon : {status_str:<65} │",
        f"│ Corpus : {stats.get('creators', len(creators))} mentors · {stats.get('plays', 0)} plays · {stats.get('places', 0)} cities · Checked {dataset.get('checkedDate', '2026-11-11')}       │",
        "├────────────────────────────────────────────────────────────────────────────┤",
    ]
    for w in wave:
        lines.append(f"│  {w:<72}  │")
    lines.append("├────────────────────────────────────────────────────────────────────────────┤")
    if query or category:
        lines.append(f"│ Filter : q={query or '*'}  category={category or '*'}  matches={len(creators):<33} │")
        lines.append("├────────────────────────────────────────────────────────────────────────────┤")

    for idx, c in enumerate(creators[:12], start=1):
        name = (c.get("name") or "")[:18]
        handle = (c.get("handle") or "")[:18]
        cat = (c.get("category") or "")[:16]
        plays_n = len(c.get("plays") or [])
        lines.append(f"│ {idx:2d}. {name:<18} {handle:<18} [{cat:<16}] {plays_n:2d} plays │")

    if len(creators) > 12:
        lines.append(f"│ ... and {len(creators) - 12} more mentors (use --search <q> or interactive mode)             │")

    if creators:
        top = creators[0]
        top_play = (top.get("plays") or [{}])[0]
        title = (top_play.get("title") or "Playbook ready")[:56]
        lines.append("├────────────────────────────────────────────────────────────────────────────┤")
        lines.append(f"│ Featured Play ({top.get('name', '')}): {title:<48} │")

    lines.append("└────────────────────────────────────────────────────────────────────────────┘")
    return "\n".join(lines)


def run_interactive(dataset: dict, daemon: dict, initial_query: str = "", initial_category: str = "") -> None:
    creators_all = dataset.get("creators", [])
    query = initial_query
    category = initial_category
    selected = 0
    phase = 0.0

    def draw(stdscr) -> None:
        nonlocal query, selected, phase
        curses.curs_set(0)
        stdscr.nodelay(True)
        stdscr.timeout(120)

        while True:
            items = filter_creators(creators_all, query=query, category=category)
            if selected >= len(items):
                selected = max(0, len(items) - 1)

            h, w = stdscr.getmaxyx()
            stdscr.erase()
            wave_cols = max(16, min(64, (w - 4) // 1))
            wave = render_braille_wave(cols=wave_cols, rows=2, phase=phase)
            phase += 0.14

            header = f"CreatorPlaybooks v{VERSION} | {len(items)}/{len(creators_all)} mentors | :5185 {'ONLINE' if daemon['online'] else 'IDLE'} | q:quit /:search"
            stdscr.addnstr(0, 1, header, max(1, w - 2), curses.A_BOLD)
            for idx, wline in enumerate(wave, start=1):
                if idx < h - 2:
                    stdscr.addnstr(idx, 1, wline, max(1, w - 2))

            list_top = 4
            list_h = max(3, h - list_top - 2)
            split_x = max(28, min(42, w // 3))

            for i in range(min(list_h, len(items))):
                c = items[i]
                label = f"{c.get('name', '')} ({c.get('handle', '')})"
                attr = curses.A_REVERSE if i == selected else curses.A_NORMAL
                if list_top + i < h - 1:
                    stdscr.addnstr(list_top + i, 1, label[: split_x - 2], max(1, split_x - 2), attr)

            if items and w > split_x + 12:
                cur = items[selected]
                col_x = split_x + 2
                col_w = max(10, w - col_x - 1)
                detail_lines = [
                    f"{cur.get('name', '')} {cur.get('handle', '')} [{cur.get('followersStr', '')}]",
                    f"Category: {cur.get('category', '')} | Tags: {', '.join(cur.get('tags') or [])}",
                    "",
                    "Bio: " + (cur.get("bio") or "").replace("\n", " "),
                    "",
                    f"Plays ({len(cur.get('plays') or [])}):",
                ]
                for p in (cur.get("plays") or [])[:5]:
                    detail_lines.append(f"  - {p.get('title', '')} ({p.get('frequency', '')})")
                    detail_lines.append(f"    Action: {(p.get('action') or '')[:120]}")
                detail_lines.append("")
                detail_lines.append("Hooks:")
                for hk in (cur.get("hooks") or [])[:3]:
                    detail_lines.append(f"  * {hk[:120]}")

                for idx, dline in enumerate(detail_lines[:list_h]):
                    if list_top + idx < h - 1:
                        stdscr.addnstr(list_top + idx, col_x, dline, col_w)

            footer = f"Search: '{query}'  [Up/Down: navigate | c: clear search | q: quit]"
            if h > 1:
                stdscr.addnstr(h - 1, 1, footer, max(1, w - 2), curses.A_DIM)
            stdscr.refresh()

            ch = stdscr.getch()
            if ch in (ord("q"), ord("Q"), 27):
                break
            elif ch in (curses.KEY_DOWN, ord("j")):
                if items:
                    selected = (selected + 1) % len(items)
            elif ch in (curses.KEY_UP, ord("k")):
                if items:
                    selected = (selected - 1) % len(items)
            elif ch == ord("c"):
                query = ""
                selected = 0
            elif ch == ord("/"):
                stdscr.nodelay(False)
                curses.echo()
                stdscr.addnstr(h - 1, 1, "Search query: " + " " * max(0, w - 16), max(1, w - 2))
                try:
                    raw = stdscr.getstr(h - 1, 15, 40)
                    query = raw.decode("utf-8", errors="ignore").strip()
                    selected = 0
                except Exception:
                    pass
                curses.noecho()
                stdscr.nodelay(True)
                stdscr.timeout(120)

    curses.wrapper(draw)


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="creatorplaybooks-tui",
        description="CreatorPlaybooks Unicode U+2800 Braille terminal TUI (35 creators, 115 plays, 20 places).",
    )
    parser.add_argument("--once", action="store_true", help="Render a single non-interactive Braille snapshot and exit")
    parser.add_argument("--json", action="store_true", help="Print JSON summary of dataset and live :5185 status")
    parser.add_argument("--search", "-s", default="", help="Filter mentors by name, handle, bio, tag, or play title")
    parser.add_argument("--category", "-c", default="", help="Filter mentors by category id")
    parser.add_argument("--version", "-v", action="store_true", help="Print version and exit")
    args = parser.parse_args()

    if args.version:
        print(f"creatorplaybooks-tui {VERSION}")
        return 0

    root = resolve_repo_root()
    dataset = load_dataset(root)
    daemon = probe_daemon()

    if args.json:
        matches = filter_creators(dataset.get("creators", []), query=args.search, category=args.category)
        out = {
            "service": "creatorplaybooks-tui",
            "version": VERSION,
            "brailleHeader": render_braille_wave(cols=24, rows=1)[0],
            "installRoot": redact_path(root),
            "daemon": daemon,
            "stats": dataset.get("stats", {}),
            "matchCount": len(matches),
            "matches": [
                {
                    "id": c["id"],
                    "name": c["name"],
                    "handle": c["handle"],
                    "category": c["category"],
                    "playsCount": len(c.get("plays") or []),
                }
                for c in matches
            ],
        }
        print(json.dumps(out, indent=2))
        return 0

    if args.once or not sys.stdout.isatty():
        print(render_once(dataset, daemon, query=args.search, category=args.category))
        return 0

    run_interactive(dataset, daemon, initial_query=args.search, initial_category=args.category)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
